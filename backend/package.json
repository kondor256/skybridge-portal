{
  "name": "skybridge-services-portal",
  "version": "1.0.0",
  "description": "SkyBridge Services Portal: Express API that also serves the built Vue front end",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:reset": "node --env-file-if-exists=.env scripts/run-sql.js",
    "hash": "node scripts/hash-password.js",
    "encrypt-existing": "node scripts/encrypt-existing.js",
    "test": "node --env-file-if-exists=.env --test test/crypto.test.js test/api.test.js",
    "test:crypto": "node --test test/crypto.test.js",
    "bundle": "node scripts/bundle.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
