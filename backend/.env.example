# Copy to .env for local work. Never commit .env.
# On Azure these are App Service "Environment variables"; on AWS they are
# Elastic Beanstalk "Environment properties".

PGHOST=localhost
PGPORT=5433
PGDATABASE=skybridge
PGUSER=skybridge
PGPASSWORD=change-me
# disable (local) | require (Azure, RDS: encrypted) | verify-full (also checks the server certificate)
PGSSLMODE=disable
# Only for verify-full when the CA is not in Node's trust store (e.g. the RDS global bundle)
# PGSSLROOTCERT=/path/to/global-bundle.pem

# Long random string; must be the same on every instance
SESSION_SECRET=change-me-to-a-long-random-string
# pg (default, needed behind a load balancer) | memory (local only)
SESSION_STORE=pg

PORT=3000
NODE_ENV=development
# Shown in the page footer: local | azure | aws
CLOUD_PLATFORM=local

# A3: proxies in front of the app: 0 local, 1 Azure App Service, 2 AWS (CloudFront + load balancer)
TRUST_PROXY_HOPS=0
# A3: true on AWS behind CloudFront (visitor protocol from CloudFront-Forwarded-Proto)
TRUST_CLOUDFRONT_PROTO=false

# A3: AES-256 key for field encryption = base64 of 32 random bytes. Use a different key per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Azure: Key Vault reference (data-key-v1); AWS: Secrets Manager (skybridge-a3/data-key-v1)
DATA_KEY_V1=

# A3: login protection (these are the defaults)
# LOCKOUT_THRESHOLD=5            wrong passwords in a row that lock an account
# LOCKOUT_MINUTES=15             how long the account stays locked
# AUTH_RATE_LIMIT=10             failed login/registration requests per client IP ...
# AUTH_RATE_WINDOW_MINUTES=15    ... in this window, then HTTP 429
